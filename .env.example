# Copy to .env for local development (spec 02 §10).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://ndc:ndc@localhost:5432/ndcbackend

# Clerk — use the DEVELOPMENT instance keys here; production uses a separate instance.
CLERK_SECRET_KEY=sk_test_xxx
# Optional: networkless token verification. Clerk Dashboard → API keys → "JWT public key" (PEM, one line is fine).
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Frontend origins allowed to mint tokens for this API (token `azp` claim).
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production only: number of reverse proxies in front of Django.
NUM_PROXIES=0

# Donations (spec 05). Closed until legal sign-off. NEVER put live keys in this file or in chat.
# Local development: PAYMENT_PROVIDER=fake needs no keys. To try Paystack locally, use TEST keys (sk_test_...).
FRONTEND_BASE_URL=http://localhost:5173
DONATIONS_ENABLED=False
DONATIONS_COMPLIANCE_APPROVED=False
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=

# Membership + PVC (spec 06). Closed until party/legal sign-off.
MEMBERSHIP_ENABLED=False
MEMBERSHIP_DATA_APPROVED=False
# Leave empty until the official INEC URL is confirmed.
INEC_PVC_URL=
# Production: generate with  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Development leaves this empty (a local key file is created). NEVER commit or paste real keys.
PII_ENCRYPTION_KEYS=

# News (spec 07). Leave unset to use the 2027 general-election blackout windows (JSON list of
# {"positions": [...], "start": ISO-8601, "end": ISO-8601}).
# CAMPAIGN_BLACKOUTS=
# Spec 14: security and privacy
# CONTROLLER_NAME=<the party's legal name as data controller> (spec 14 §15.1)
PRIVACY_CONTACT_EMAIL=
SECURITY_CONTACT_EMAIL=
HOSTING_LOCATION=
ADMIN_MFA_REQUIRED=False
REVERIFY_MINUTES=10
CROSS_ORIGIN_RESOURCE_POLICY=same-site

# --- Spec 15: API and integration -------------------------------------------
# Optional Paystack webhook source allow-list (comma-separated IPs). Empty = off; the signature is the control.
PAYSTACK_WEBHOOK_IPS=
# Shared cache: `database` in production (run `python manage.py migrate`; the cache table is created by a migration).
CACHE_BACKEND=memory
# Request logging: warn above this many milliseconds; LOG_FORMAT=json for one JSON object per line.
SLOW_REQUEST_MS=1500
LOG_FORMAT=text
# Images: `local` (files under media/) or `cloudinary`. Create the preset with `python manage.py cloudinary_setup`.
MEDIA_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Backend only. Never in the frontend, never in Git.
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=ndcconnect_signed
# One folder per environment: ndcconnect/dev, ndcconnect/staging, ndcconnect/prod
CLOUDINARY_FOLDER=ndcconnect/dev
